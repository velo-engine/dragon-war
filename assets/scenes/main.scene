# The game. Board/Slots are the battle slots (dragons there attack), Board/Bench is where new dragons wait.
# Game (src/game.v) reads the cell positions from these nodes, so the layout can be changed in the editor.
node Main {
  node Audio from @asset("a96202a7") { }
  node Background {
    position = [270, 480]
    UITransform { size = [540, 960] }
    Widget { align_left = true  align_right = true  align_top = true  align_bottom = true  safe_area = false }
    Panel { color = [36, 30, 62, 255]  block_input = false }
  }
  node Board {
