# imp: a Kine2D skeleton (characters/imp.*) that marches down the field. Enemy comes from src/enemy.v;
# the Game keeps these nodes in a pool, so they are created once and reused.
node EnemyImp {
  Enemy { kind = "imp" }
  node Shadow {
    position = [0, 12.3036]
    Sprite { texture = @asset("42591516")  size = [30.42, 13.36] }
  }
  node Body {
    scale = [0.78, 0.78]
    Kine2D { data = @asset("51b72eec")  atlas = @asset("eea33d43")  animation = "walk" }
  }
  node Bar {
    position = [0, -37.9848]
    UITransform { size = [34, 6] }
    ProgressBar { progress = 1  fill_color = [96, 220, 112, 255]  back_color = [24, 14, 30, 210]  radius = 3 }
  }
}
