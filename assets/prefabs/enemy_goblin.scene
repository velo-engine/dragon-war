# goblin: a Kine2D skeleton (characters/goblin.*) that marches down the field. Enemy comes from src/enemy.v;
# the Game keeps these nodes in a pool, so they are created once and reused.
node EnemyGoblin {
  Enemy { kind = "goblin" }
  node Shadow {
    position = [0, 15.33]
    Sprite { texture = @asset("42591516")  size = [35.1, 13.36] }
  }
  node Body {
    scale = [0.78, 0.78]
    Kine2D { data = @asset("f4250c40")  atlas = @asset("21ff3c3c")  animation = "walk" }
  }
  node Bar {
    position = [0, -44.1]
    UITransform { size = [34, 6] }
    ProgressBar { progress = 1  fill_color = [96, 220, 112, 255]  back_color = [24, 14, 30, 210]  radius = 3 }
  }
}
