    }
    node Restart {
      position = [0, 56]
      UITransform { size = [270, 48] }
      Panel { color = [70, 120, 210, 255]  radius = 10  border_width = 1 }
      Button { }
      node Text {
        position = [0, 0]
        UITransform { size = [262, 44] }
        Label { text = "Restart"  size = 22  align = "center"  valign = "middle"  color = [255, 255, 255, 255]  shadow_color = [0, 0, 0, 150]  shadow_offset = [1, 2]  }
