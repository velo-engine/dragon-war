    }
    node Menu {
      position = [0, 116]
      UITransform { size = [270, 48] }
      Panel { color = [110, 100, 130, 255]  radius = 10  border_width = 1 }
      Button { }
      node Text {
        position = [0, 0]
        UITransform { size = [262, 44] }
        Label { text = "Main menu"  size = 22  align = "center"  valign = "middle"  color = [255, 255, 255, 255]  shadow_color = [0, 0, 0, 150]  shadow_offset = [1, 2]  }
