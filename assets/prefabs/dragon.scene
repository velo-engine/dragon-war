# A dragon. Dragon (src/dragon.v) swaps the Kine2D files of Body to the ones of its level (characters/dragon1..6),
# so one prefab (and one pool) serves every level.
node Dragon {
  Dragon { }
  node Shadow {
    position = [0, 36]
    Sprite { texture = @asset("42591516")  size = [70, 22] }
  }
  node Body {
    position = [0, 10]
    scale = [0.85, 0.85]
    Kine2D { data = @asset("954d179e")  atlas = @asset("bd5de3d9")  animation = "idle" }
  }
  node Badge {
    position = [-31, -36]
    UITransform { size = [30, 20] }
    Panel { color = [24, 18, 44, 215]  radius = 9  border_width = 1  border_color = [255, 224, 120, 220]  block_input = false }
    node Text {
      UITransform { size = [30, 20] }
      Label { text = "1"  size = 15  align = "center"  valign = "middle"  color = [255, 230, 130, 255] }
    }
  }
}
